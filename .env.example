# Copy this file to .env and fill in your key. .env is gitignored.
# Free key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Several keys may be listed, comma separated (e.g. one per team member);
# the fetcher rotates between them and rests any key that nears its limit.
FIRMS_MAP_KEY=

# Optional overrides
# KELVIN_DATA_DIR=data
# KELVIN_HOST=127.0.0.1
# KELVIN_PORT=8000
